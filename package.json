{
  "name": "haestore-api",
  "version": "0.1.0",
  "private": true,
  "description": "H\u00e6store API \u2014 Express 5, TypeScript, Mongoose 8",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check:all": "npm run check && npm run test:integration",
    "openapi:generate": "tsx src/openapi/generate.ts",
    "openapi:check": "npm run openapi:generate && git diff --exit-code openapi.json",
    "search:reindex": "tsx src/search/reindex.cli.ts",
    "search:reconcile": "tsx src/search/reconcile.cli.ts",
    "seed": "tsx src/seed/seed.cli.ts",
    "seed:photos": "tsx src/seed/photos.cli.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "bullmq": "^6.3.4",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "meilisearch": "^0.47.0",
    "mongoose": "^8.9.5",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "rate-limit-redis": "^4.2.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^7.2.1",
    "blurhash": "^2.0.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  }
}
