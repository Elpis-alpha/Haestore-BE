# Hæstore API environment.
# Generated during the Phase 0 rebuild. Old 2022 values preserved where still relevant;
# see .env.backup-2022 for the original file.

# ---- Runtime --------------------------------------------------------------
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
PUBLIC_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:3000

# ---- Datastores -----------------------------------------------------------
# directConnection=true is REQUIRED: without it the driver follows the replica set's
# advertised localhost:27017 and reaches the other mongod on this machine. See ADR-002.
MONGODB_URL=mongodb://127.0.0.1:27018/haestore?replicaSet=rs0&directConnection=true
REDIS_URL=redis://127.0.0.1:6380
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_API_KEY=haestore_dev_master_key_change_me

# ---- Auth -----------------------------------------------------------------
# Server-side peppers. Never leave this machine; a Redis dump is useless without them.
OTP_PEPPER=
GUEST_COOKIE_SECRET=
# Granted the admin role at OTP verification time. Comma-separated.
ADMIN_EMAILS=

# ---- Mail (Mailpit in dev — read sign-in codes at http://localhost:8025) ----
# console | gmail-api.
#   console   — prints the message to the log. A fresh clone with no Google
#               credentials boots and works; sign-in codes appear in the API log.
#   gmail-api — sends for real, over HTTPS 443.
# There is deliberately no SMTP transport: most VPS hosts block outbound
# 25/465/587, so an SMTP send hangs rather than failing. Carrying a transport that
# cannot be the production one only buys production-only bugs.
MAIL_DRIVER=console

# Required by the gmail-api driver. The refresh token needs https://mail.google.com/
# or .../auth/gmail.send, and the Gmail API must be enabled on the Cloud project that
# owns the client id, or sends return 403 accessNotConfigured. MAIL_REDIRECT_URI is
# only used when first minting the refresh token.
# See docs/GMAIL-API-MIGRATION-NOTE.md.
MAIL_CLIENT_ID=
MAIL_CLIENT_SECRET=
MAIL_REFRESH_TOKEN=
MAIL_REDIRECT_URI=

MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Hæstore

# ---- Media ----------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=haestore

# ---- Seeding --------------------------------------------------------------
UNSPLASH_ACCESS_KEY=
UNSPLASH_APP_NAME=haestore

# ---- Payments (test mode) -------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
